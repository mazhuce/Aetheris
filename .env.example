# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交。
POSTGRES_DB=aetheris
POSTGRES_USER=aetheris
POSTGRES_PASSWORD=replace-with-a-random-strong-password
POSTGRES_PORT=5433
DB_NAME=aetheris
DB_USER=aetheris
DB_PASSWORD=use-the-same-random-password-as-postgres-for-local-compose
AETHERIS_DATASOURCE_MASTER_KEY=generate-a-base64-32-byte-key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000
AETHERIS_RATE_LIMIT_CAPACITY=60
AETHERIS_RATE_LIMIT_WINDOW_SECONDS=60
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-first-start
INITIAL_ADMIN_NICKNAME=系统管理员
# 服务间内部端点（/internal/**）共享令牌；生产环境必须替换
AETHERIS_INTERNAL_TOKEN=change-me-internal-token
AETHERIS_IMAGE_TAG=m1-exec-base-20260908
AETHERIS_OPENAPI_ENABLED=false
# Spring 服务数据库连接池基线；为扩容副本和运维会话预留 PostgreSQL 连接。
AETHERIS_DB_POOL_MIN_IDLE=1
AETHERIS_DB_POOL_MAX_SIZE=8
# M2 本机 WSL 受管 Spark runner。启用时请用独立的 32+ 字节随机令牌，不能复用内部服务令牌。
AETHERIS_SPARK_RUNNER_ENABLED=false
AETHERIS_SPARK_RUNNER_BASE_URL=http://host.docker.internal:18081
AETHERIS_SPARK_RUNNER_TOKEN=replace-with-a-dedicated-random-32-byte-token
AETHERIS_SPARK_RUNNER_POLL_INTERVAL_MS=5000
AETHERIS_SPARK_RUNNER_QUEUE_DISPATCH_INTERVAL_MS=2000
# M5 Git 远端只允许显式主机；私有仓库凭据使用 AETHERIS_GIT_CREDENTIAL_* 专用环境变量引用。
AETHERIS_GIT_ALLOWED_HOSTS=github.com,gitee.com
AETHERIS_GIT_CONNECT_TIMEOUT_SECONDS=8
# 流水线异步执行租约：节点超时之外保留恢复余量，定时释放进程崩溃遗留的活跃记录。
AETHERIS_PIPELINE_DISPATCH_LEASE_SECONDS=120
AETHERIS_PIPELINE_LEASE_GRACE_SECONDS=120
AETHERIS_PIPELINE_RECONCILE_INTERVAL_MS=30000
GATEWAY_PORT=8080
WEB_PORT=5173

REDIS_PASSWORD=replace-with-a-long-random-secret
